extends layout


block content
  div.container
    form.form-signin
      center
        h2.form-signin-heading= title
      p
        //Caixa de input do e-mail
        input.form-control(type='email' id='inputEmail' placeholder='Informe seu e-mail' required autofocus)
      p
        input.form-control(type='password' id='inputPassword' placeholder='Informe sua senha' required)
        center
          p 
          button.btn.btn-warning.btn-xs(type='button') Lembrar Senha
      p
        button.btn.btn-lg.btn-primary.btn-block(type='submit') Entrar